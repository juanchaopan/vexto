# The worker image gets only what the Cloud Run entries run: the manifest and lockfile for the
# dependencies with the script that drops the web-only packages from both, the release version,
# the release configuration and the code below src/worker/, src/features/ and src/lib/.
# Everything else, tests included, stays out of the build context.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!scripts/worker-image.json
!scripts/worker-dependencies.ts
!scripts/lib/worker-dependencies.ts
!VERSION
!config/
!src/worker/
!src/features/
!src/lib/
**/*.test.ts
**/*.test.tsx
